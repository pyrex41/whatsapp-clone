  describe "notification delivery tracking" do
    test "marks notification as delivered" do
      notification =
        %Notification{
          user_id: Ecto.UUID.generate(),
          thread_id: Ecto.UUID.generate(),
          message_id: Ecto.UUID.generate(),
          device_token: "token",
