        }

        XCTAssertTrue(stateManager.messages.isEmpty)
        XCTAssertTrue(stateManager.presences.isEmpty)
        XCTAssertTrue(stateManager.typingUsers.isEmpty)
    }

    // MARK: - Connection Tests

