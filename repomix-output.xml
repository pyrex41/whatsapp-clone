    test "retrieves user notifications with limit", %{user: user, thread: thread} do
      # Create multiple notifications
      for i <- 1..10 do
        %Notification{
          user_id: user.id,
          thread_id: thread.id,
          message_id: Ecto.UUID.generate(),
          device_token: "token_#{i}",
          platform: "apns",
