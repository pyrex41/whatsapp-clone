        |> Repo.insert!()

      assert {:ok, updated} = Notifications.send_notification(notification)
      assert updated.status == "sent"
      assert updated.sent_at != nil
    end

    test "sends FCM notification", %{user: user, thread: thread} do
      notification =
        %Notification{
          user_id: user.id,
