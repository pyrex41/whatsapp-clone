                ToolbarItem(placement: .confirmationAction) {
                    Button("Create") {
                        store.send(.createThread)
                    }
                    .disabled(threadsState.creationTitle.trimmingCharacters(in: .whitespaces).isEmpty || threadsState.isCreatingThread)
