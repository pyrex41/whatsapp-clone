        }
        |> Repo.insert!()
      end

      stats = Notifications.get_delivery_stats(user.id)

      assert stats["sent"] == 2
      assert stats["delivered"] == 1
      assert stats["failed"] == 1
      assert stats["pending"] == 1
    end
  end
end
