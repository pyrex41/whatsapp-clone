        |> Repo.update!()

      assert updated.status == "failed"
      assert updated.failed_at != nil
      assert updated.error_message == "Connection timeout"
      assert updated.retry_count == 1
      assert updated.last_retry_at != nil
    end
  end

  describe "notification queries" do
    setup do
