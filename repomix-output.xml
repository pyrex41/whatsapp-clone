  user_id: "user123",
  conversation_id: "conv123",
  is_typing: true,
  timestamp: "2025-10-20T12:00:00Z"
})

// Read receipt
channel.on("read_receipt", %{
  user_id: "user123",
  conversation_id: "conv123",
  message_id: "msg123",
  read_at: "2025-10-20T12:00:00Z"
})

// Presence diff
channel.on("presence_diff", %{
  joins: %{"user123" => %{metas: [...]}},
  leaves: %{"user456" => %{metas: [...]}}
})
