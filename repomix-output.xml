    // MARK: - Insert Operation Tests

    func testCDCTriggerFiresOnMessageInsert() async throws {
        // Given: A new message
        let message = Message(
            id: UUID(),
            threadId: testThread.id,
            senderId: UUID(),
            content: "Test message for CDC",
            messageType: .text,
            status: .sent,
