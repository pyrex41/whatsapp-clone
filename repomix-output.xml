        let config = PhoenixConfig.development

        XCTAssertEqual(config.socketURL.scheme, "ws")
        XCTAssertEqual(config.socketURL.host, "localhost")
        XCTAssertEqual(config.socketURL.port, 4000)
        XCTAssertTrue(config.enableLogging)
