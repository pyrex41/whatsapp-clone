  sender_id: user_id,
  content_type: "text",
  content: "Hello, world!"
})

Messages.create_message(thread_id, %{
  sender_id: user_id,
  content_type: "image",
  media_url: "https://example.com/image.jpg",
  media_size: 1024,
  media_mime_type: "image/jpeg"
})

# Edit message
