    func testClearQueue_ShouldRemoveAllQueuedMessages() async throws {
        // Given
        let messages = [
            Message(id: UUID(), threadId: testThread.id, senderId: UUID(), content: "Msg 1"),
            Message(id: UUID(), threadId: testThread.id, senderId: UUID(), content: "Msg 2"),
