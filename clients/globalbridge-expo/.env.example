# Copy this file to .env.local or export the variable inline before running Expo.
#
# For iOS simulator on the same machine as the Phoenix backend:
#   EXPO_PUBLIC_API_URL=http://127.0.0.1:4000/api
# For Android emulator (10.0.2.2 resolves to host machine):
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api
# For physical devices, replace with your LAN IP (e.g. http://192.168.1.42:4000/api).

EXPO_PUBLIC_API_URL=http://localhost:4000/api

# Auth0 configuration (required for SSO login)
EXPO_PUBLIC_AUTH0_DOMAIN=your-tenant.us.auth0.com
EXPO_PUBLIC_AUTH0_CLIENT_ID=your-client-id
EXPO_PUBLIC_AUTH0_AUDIENCE=https://globalbridge-api
