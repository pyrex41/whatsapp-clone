{
  "name": "globalbridge-expo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --clear",
    "dev:ios": "cross-env EXPO_PUBLIC_API_URL=http://127.0.0.1:4000/api expo start --ios",
    "dev:android": "cross-env EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api expo start --android",
    "dev:tunnel": "cross-env EXPO_PUBLIC_API_URL=http://localhost:4000/api expo start --tunnel",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint \"{app,src}/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "e2e:ios": "detox test --configuration ios.sim.debug",
    "e2e:android": "detox test --configuration android.emu.debug"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.3",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/native": "^6.1.18",
    "@tanstack/react-query": "^5.59.15",
    "eventemitter3": "5.0.1",
    "expo": "^51.0.13",
    "expo-crypto": "~13.0.0",
    "expo-file-system": "~17.0.1",
    "expo-linking": "~6.3.1",
    "expo-local-authentication": "~14.0.1",
    "expo-router": "^3.5.16",
    "expo-secure-store": "~13.0.1",
    "expo-sqlite": "~14.0.6",
    "expo-status-bar": "~1.12.1",
    "expo-system-ui": "~3.0.7",
    "immer": "^10.1.1",
    "phoenix": "^1.7.11",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "~2.16.2",
    "react-native-pager-view": "6.3.0",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-svg": "15.2.0",
    "react-native-web": "~0.19.13",
    "superjson": "^2.2.1",
    "zod": "^3.23.8",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react": "^14.2.2",
    "@testing-library/react-native": "^12.6.2",
    "@types/eventemitter3": "2.0.4",
    "@types/react": "~18.2.67",
    "@types/react-dom": "~18.2.22",
    "@types/react-native": "~0.73.0",
    "@typescript-eslint/eslint-plugin": "^8.9.0",
    "@typescript-eslint/parser": "^8.9.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "11.0.5",
    "cross-env": "^7.0.3",
    "detox": "^20.13.0",
    "eslint": "^9.14.0",
    "eslint-config-universe": "^14.1.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-native": "^4.1.0",
    "globals": "^15.9.0",
    "hermes-parser": "^0.12.0",
    "msw": "^2.6.8",
    "typescript": "^5.4.5",
    "vitest": "^2.1.4"
  }
}
