<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Cross-target for iOS solution builds and device-specific APIs if needed -->
    <TargetFrameworks>net9.0;net9.0-ios18.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AuthHttp.fs" />
    <Compile Include="PhoenixChannel.fs" />
    <Compile Include="MessageStore.fs" />
    <Compile Include="MessagingService.fs" />
    <Compile Include="DemoData.fs" />
    <Compile Include="AuthApi.fs" />
    <Compile Include="RestClient.fs" />
    <Compile Include="SyncService.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GlobalBridge.Core\GlobalBridge.Core.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="9.0.0" />
  </ItemGroup>
</Project>
