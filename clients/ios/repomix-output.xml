    // MARK: - CDC Log Integrity Tests

    func testCDCLogContainsCompleteData() async throws {
        // Given: A message with all fields populated
        let metadata = ["type": "image", "url": "https://example.com/image.jpg"]
        let replyToId = UUID()

        let message = Message(
