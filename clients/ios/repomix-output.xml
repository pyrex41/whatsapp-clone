    // MARK: - Task 13.2: Pull/Push Logic Tests

    func testPullChangesFromServer() async throws {
        // Given: Server has changes for this thread
        let serverLogs = [
            CDCLog(
                tableName: "messages",
                recordId: UUID(),
                operation: .insert,
                newData: ["content": "Server message 1", "status": "sent"],
                timestamp: Date().addingTimeInterval(-60)
            ),
            CDCLog(
                tableName: "messages",
                recordId: UUID(),
