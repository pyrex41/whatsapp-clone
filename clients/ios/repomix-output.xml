    public let userId: String
    public let conversationId: String
    public let messageId: String
    public let readAt: Date

    enum CodingKeys: String, CodingKey {
        case userId = "user_id"
        case conversationId = "conversation_id"
        case messageId = "message_id"
        case readAt = "read_at"
    }

