# API Keys (Required to enable respective provider)
ANTHROPIC_API_KEY="your_anthropic_api_key_here"       # Required: Format: sk-ant-api03-...
PERPLEXITY_API_KEY="your_perplexity_api_key_here"     # Optional: Format: pplx-...
OPENAI_API_KEY="your_openai_api_key_here"             # Optional, for OpenAI models. Format: sk-proj-...
GOOGLE_API_KEY="your_google_api_key_here"             # Optional, for Google Gemini models.
MISTRAL_API_KEY="your_mistral_key_here"               # Optional, for Mistral AI models.
XAI_API_KEY="YOUR_XAI_KEY_HERE"                       # Optional, for xAI AI models.
GROQ_API_KEY="YOUR_GROQ_KEY_HERE"                     # Optional, for Groq models.
OPENROUTER_API_KEY="YOUR_OPENROUTER_KEY_HERE"         # Optional, for OpenRouter models.
AZURE_OPENAI_API_KEY="your_azure_key_here"            # Optional, for Azure OpenAI models (requires endpoint in .taskmaster/config.json).
OLLAMA_API_KEY="your_ollama_api_key_here"             # Optional: For remote Ollama servers that require authentication.
GITHUB_API_KEY="your_github_api_key_here"             # Optional: For GitHub import/export features. Format: ghp_... or github_pat_...

# Auth0 Configuration (Required for Auth0 authentication)
AUTH0_DOMAIN="your-auth0-domain.auth0.com"             # Required: Your Auth0 domain
AUTH0_CLIENT_ID="your_auth0_client_id"                 # Required: Auth0 application client ID
AUTH0_CLIENT_SECRET="your_auth0_client_secret"         # Required: Auth0 application client secret

# Database Configuration (Required for PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/globalbridge_dev"  # Required: PostgreSQL connection string
DATABASE_URL_TEST="postgresql://username:password@localhost:5432/globalbridge_test"  # Required: Test database connection

# Phoenix Configuration
SECRET_KEY_BASE="your_64_character_secret_key_base_here"  # Required: 64-character secret for Phoenix
PHX_HOST="localhost"                                      # Required: Host for Phoenix server
PHX_PORT="4000"                                           # Required: Port for Phoenix server

# Bridge Configuration
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"         # Optional: Telegram Bot API token
WHATSAPP_ACCESS_TOKEN="your_whatsapp_access_token_here"   # Optional: WhatsApp Business API token
WHATSAPP_PHONE_NUMBER_ID="your_phone_number_id_here"      # Optional: WhatsApp phone number ID

# Monitoring and Telemetry
PROMETHEUS_METRICS_ENABLED="true"                        # Optional: Enable Prometheus metrics (default: true)
SENTRY_DSN="your_sentry_dsn_here"                         # Optional: Sentry error tracking
LOG_LEVEL="info"                                          # Optional: Logging level (debug, info, warn, error)

# Feature Flags
BRIDGE_TELEGRAM_ENABLED="true"                           # Optional: Enable Telegram bridge (default: true)
BRIDGE_WHATSAPP_ENABLED="false"                          # Optional: Enable WhatsApp bridge (default: false)
WEBHOOK_SSL_VERIFICATION="true"                          # Optional: Enable SSL verification for webhooks (default: true)

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE="60"                      # Optional: API rate limit per minute (default: 60)
BRIDGE_MESSAGE_RATE_LIMIT="100"                          # Optional: Bridge message rate limit per minute (default: 100)

# Deployment Configuration
DEPLOYMENT_ENV="development"                             # Required: Environment (development, staging, production)
RELEASE_COOKIE="your_erlang_release_cookie_here"         # Required: Erlang distribution cookie for clustering