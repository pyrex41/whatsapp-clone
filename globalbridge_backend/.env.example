# API Keys (Required to enable respective provider)
ANTHROPIC_API_KEY="your_anthropic_api_key_here"       # Required: Format: sk-ant-api03-...
PERPLEXITY_API_KEY="your_perplexity_api_key_here"     # Optional: Format: pplx-...
OPENAI_API_KEY="your_openai_api_key_here"             # Optional, for OpenAI models. Format: sk-proj-...
GOOGLE_API_KEY="your_google_api_key_here"             # Optional, for Google Gemini models.
MISTRAL_API_KEY="your_mistral_key_here"               # Optional, for Mistral AI models.
XAI_API_KEY="YOUR_XAI_KEY_HERE"                       # Required for Grok models (Summarization). Format: xai-...
GROQ_API_KEY="YOUR_GROQ_KEY_HERE"                     # Required for Groq/Llama models (Translation, Language Detection). Format: gsk_...
OPENROUTER_API_KEY="YOUR_OPENROUTER_KEY_HERE"         # Optional, for OpenRouter models.
AZURE_OPENAI_API_KEY="your_azure_key_here"            # Optional, for Azure OpenAI models (requires endpoint in .taskmaster/config.json).
OLLAMA_API_KEY="your_ollama_api_key_here"             # Optional: For remote Ollama servers that require authentication.
GITHUB_API_KEY="your_github_api_key_here"             # Optional: For GitHub import/export features. Format: ghp_... or github_pat_...

# AI Model Configuration
OPENAI_MODEL="llama-3.1-70b-versatile"                # Default model for general AI operations (uses Groq)
TRANSLATION_MODEL="llama-3.1-70b-versatile"           # Model for translation (Groq Llama 70B)
SUMMARIZER_MODEL="grok-2-1212"                        # Model for summarization (XAI Grok)

# AI Rate Limiting Configuration (Optional - defaults provided)
AI_RATE_LIMIT_TRANSLATE=60              # Requests per minute per user for translate endpoint
AI_RATE_LIMIT_ANALYZE_TONE=30           # Requests per minute per user for analyze_tone endpoint
AI_RATE_LIMIT_SUMMARIZE_THREAD=10       # Requests per minute per user for summarize_thread endpoint
AI_RATE_LIMIT_SEARCH_SEMANTIC=30        # Requests per minute per user for search_semantic endpoint
AI_RATE_LIMIT_EXTRACT_TASKS=10          # Requests per minute per user for extract_tasks endpoint
AI_RATE_LIMIT_VEC_HEALTH=60             # Requests per minute per user for vec_health endpoint

# Rate Limit Alert Thresholds (Optional - defaults provided)
RATE_LIMIT_ALERT_THRESHOLD=10           # Number of rate limit hits before triggering alert (per user per endpoint)
RATE_LIMIT_ALERT_WINDOW_MS=3600000      # Alert window in milliseconds (default: 1 hour)