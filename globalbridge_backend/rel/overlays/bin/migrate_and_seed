#!/bin/sh
# Startup script for production - runs migrations if needed, then starts server
set -eu

echo "🚀 Starting GlobalBridge Backend..."
echo "================================================"

cd -P -- "$(dirname -- "$0")"
cd ..  # Now we're in /app

# Check if migrations have been run
echo "📦 Checking database migration status..."
MIGRATION_CHECK=$(./bin/globalbridge_backend eval "
  try do
    GlobalbridgeBackend.Repo.query('SELECT version FROM schema_migrations LIMIT 1')
    :migrations_exist
  rescue
    _ -> :no_migrations
  end
")

if [ "$MIGRATION_CHECK" = ":migrations_exist" ]; then
  echo "⏭️  Migrations already applied, skipping..."
else
  echo "📦 Running database migrations..."
  ./bin/globalbridge_backend eval "GlobalbridgeBackend.Release.migrate()"
  echo "✅ Migrations completed successfully!"
fi

echo "✅ Setup complete!"
echo "================================================"
echo ""

# Start the server
echo "🌐 Starting Phoenix server..."
PHX_SERVER=true exec ./bin/globalbridge_backend start

